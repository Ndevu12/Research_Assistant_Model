# Copy to .env and adjust for your environment:
#   cp .env.example .env

# =============================================================================
# Retrieval APIs (optional)
# =============================================================================

# Semantic Scholar — increases rate limits when set
# S2_API_KEY=your_api_key_here

# CrossRef polite pool — required when the crossref provider is enabled
# RA_CROSSREF_MAILTO=you@example.com
# CROSSREF_MAILTO=you@example.com

# =============================================================================
# LLM — Ollama (default, local-first)
# =============================================================================

RA_LLM__PROVIDER=ollama

# Model selection (supported local models: config/ollama_models.yaml)
#   auto          — pick the best model for your RAM/disk (default)
#   llama3.1:8b   — force a specific supported model (overrides auto)
#   llama3.2:3b   — force the lightweight fallback model
RA_LLM__MODEL=auto
# RA_LLM__MODEL=llama3.1:8b

RA_LLM__BASE_URL=http://localhost:11434/v1
RA_LLM__API_KEY=ollama
# OLLAMA_API_KEY=ollama

# Synthesis — see config/ollama_models.yaml for per-model hints
# Keep false for small local models; enable for 8B+ or cloud models.
# RA_SYNTHESIS__LLM_ENABLED=true

# =============================================================================
# LLM — OpenAI (or OpenAI-compatible endpoints, e.g. LM Studio)
# =============================================================================

# RA_LLM__PROVIDER=openai
# RA_LLM__MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# Or set the unified key:
# RA_LLM__API_KEY=sk-...
# Optional custom base URL (defaults to https://api.openai.com):
# RA_LLM__BASE_URL=https://api.openai.com/v1

# =============================================================================
# LLM — Anthropic
# =============================================================================

# RA_LLM__PROVIDER=anthropic
# RA_LLM__MODEL=claude-3-5-haiku-latest
# ANTHROPIC_API_KEY=sk-ant-...
# Or set the unified key:
# RA_LLM__API_KEY=sk-ant-...
# Optional custom base URL:
# RA_LLM__BASE_URL=https://api.anthropic.com

# =============================================================================
# Pipeline & app settings
# =============================================================================

RA_RANKING__TOP_K=25
RA_PIPELINE__DEBUG=false
# RA_DEBUG=1

# Optional: override config directory
# RA_CONFIG_DIR=/path/to/config
